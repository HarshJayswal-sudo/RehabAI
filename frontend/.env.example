# Environment variables for PhysioAssist Frontend

# Render Backend URL (replace with your actual Render service URL after deployment)
# Example: https://rehabai-backend.onrender.com
VITE_API_URL=https://rehabai-backend.onrender.com

# Optional: override WebSocket URL if different from VITE_API_URL
# VITE_WS_URL=wss://rehabai-backend.onrender.com/ws/session
